# Environment variables template for mdmpi_mobile_app
# Copy this file to .env and fill in your actual values
# The .env file is ignored by Git for security

# API Configuration
# Live production host used by /api3/* and all non-/api4 integrations.
API_URL=https://inventory.mdmpi.com.ph

# MDMPI.App production-testing host used only by /api4/* requests.
# API4_URL defaults to API_URL when it is omitted.
API4_URL=https://inventory.mdmpi.com.ph

# Optional local overrides when running MDMPI.App from the full-stack workspace.
# These are used only in debug builds; release builds ignore them.
# API4_URL_WINDOWS=http://localhost:5177
# API4_URL_ANDROID=http://10.0.2.2:5177

API_KEY=your_api_key_here

# AI Toolkit configuration (examples)
# Option A: Full Google Generative Language endpoint (not recommended to embed key in URL)
AI_TOOLKIT_GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent?key=REPLACE_WITH_API_KEY

# Option B: Preferred — provide model and API key separately
AI_TOOLKIT_MODEL=gemini-2.5-flash-lite
AI_TOOLKIT_API_KEY=REPLACE_WITH_API_KEY
AI_TOOLKIT_AUTH_TYPE=bearer
AI_TOOLKIT_PROVIDER=google

# Optional default prompt (wrap multi-word values in quotes)
AI_PROMPT="Extract inventory items from the provided image or PDF and return a JSON array of objects with fields: itemCode, description, qty, unit."

# Toggle to force Google Generative Language flow
USE_GOOGLE_GENERATIVE=false
